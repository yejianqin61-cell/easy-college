{
  "name": "easy-college",
  "version": "0.4.0",
  "description": "Agent skills that turn university courseware into faithful study notes and revision notes, with a per-page triage ledger, a knowledge map, and the lecture's own self-test questions in a column at the end.",
  "type": "module",
  "bin": {
    "easy-college": "bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "scripts/",
    ".claude-plugin/",
    "docs/",
    "!docs/CST204-*.md",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "list": "node bin/cli.js --list",
    "test": "node scripts/test-repo.mjs"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "courseware",
    "study-notes",
    "revision-notes",
    "exam-prep",
    "knowledge-map",
    "mind-map",
    "self-test",
    "lecture",
    "pdf",
    "pptx",
    "docx",
    "html",
    "knowledge-extraction",
    "quiz",
    "claude",
    "llm"
  ],
  "author": "Ye Jianqin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yejianqin61-cell/easy-college.git"
  },
  "homepage": "https://github.com/yejianqin61-cell/easy-college#readme",
  "bugs": {
    "url": "https://github.com/yejianqin61-cell/easy-college/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
